# StreamVersion 1.2
# The trigger rule: pressing the bell while the message center is open but covered by the
# shortcut sheet brings it back to the front instead of closing it.
RenderEvent 0 0 0 0 0 0 0
TimerEvent 0 0 0 0 0 0 0
TimerEvent 0 0 0 0 0 0 0
TimerEvent 0 0 0 0 0 0 0
# Open the shortcut sheet (H)
KeyPressEvent 150 300 0 104 1 h 0
CharEvent 150 300 0 104 1 h 0
KeyReleaseEvent 150 300 0 104 1 h 0
TimerEvent 150 300 0 0 0 0 0
TimerEvent 150 300 0 0 0 0 0
TimerEvent 150 300 0 0 0 0 0
TimerEvent 150 300 0 0 0 0 0
TimerEvent 150 300 0 0 0 0 0
TimerEvent 150 300 0 0 0 0 0

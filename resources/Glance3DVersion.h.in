// This header is generated by CMake from resources/Glance3DVersion.h.in.
// It exposes the Glance3D version (single-sourced from F3D_VERSION in the
// top-level CMakeLists) to the Windows VERSIONINFO resource (resources/f3d.rc)
// so the embedded FileVersion/ProductVersion are never hardcoded.
#ifndef Glance3DVersion_h
#define Glance3DVersion_h

#define GLANCE3D_VERSION_MAJOR @F3D_MAJOR_VERSION@
#define GLANCE3D_VERSION_MINOR @F3D_MINOR_VERSION@
#define GLANCE3D_VERSION_PATCH @F3D_PATCH_VERSION@
#define GLANCE3D_VERSION_STR   "@F3D_VERSION@"

#endif

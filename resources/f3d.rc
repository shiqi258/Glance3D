#include <windows.h>

// Glance3D version macros, generated by CMake from resources/Glance3DVersion.h.in
// (kept next to F3DConfig.h in the application build tree). Single-sources the
// version from F3D_VERSION so the VERSIONINFO block below is never hardcoded.
#include "Glance3DVersion.h"

// Application icon (kept first so Explorer/taskbar pick it up).
IDI_ICON1 ICON DISCARDABLE "logo.ico"

// Windows version information — shown in Task Manager and the file Properties dialog.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GLANCE3D_VERSION_MAJOR,GLANCE3D_VERSION_MINOR,GLANCE3D_VERSION_PATCH,0
 PRODUCTVERSION GLANCE3D_VERSION_MAJOR,GLANCE3D_VERSION_MINOR,GLANCE3D_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Glance3D"
            VALUE "FileDescription",  "Glance3D - A fast and minimalist 3D viewer"
            VALUE "FileVersion",      GLANCE3D_VERSION_STR
            VALUE "InternalName",     "glance3d"
            VALUE "LegalCopyright",   "Copyright (C) Glance3D contributors"
            VALUE "OriginalFilename", "glance3d.exe"
            VALUE "ProductName",      "Glance3D"
            VALUE "ProductVersion",   GLANCE3D_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
